  "description": "Makes Logseq look like a native app on the Linux GNOME desktop environment: Adwaita surfaces and metrics, one merged headerbar, round window controls. Light and dark.",
  "author": "CR0CKER",
  "license": "MIT",
  "main": "index.html",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"tests/static/*.test.mjs\"",
    "test:live": "node tests/live/run.mjs",
    "test:all": "npm test && npm run test:live"
  },
  "devDependencies": {
    "@logseq/libs": "^0.0.17",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "logseq": {
    "id": "gnome-adwaita-theme",
    "title": "gnome-adwaita-theme",
    "icon": "./icon.png"
